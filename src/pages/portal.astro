---
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadContent } from '../content/load.js';
import { contentForPage } from '../content/core.js';
import Portal from '../islands/Portal.jsx';
const content = contentForPage(loadContent(), '/portal');
---
<SiteLayout
  path="/portal">
  <Portal client:load content={content} />
</SiteLayout>
