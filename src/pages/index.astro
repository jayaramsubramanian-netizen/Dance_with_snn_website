---
import SiteLayout from '../layouts/SiteLayout.astro';
import { loadContent } from '../content/load.js';
import { contentForPage } from '../content/core.js';
import Home from '../islands/Home.jsx';
const content = contentForPage(loadContent(), '/');
---
<SiteLayout
  path="/"
  heroPreload={content['home.hero.image']}>
  <Home client:load content={content} />
</SiteLayout>
